{
  "defaults": {
    "app_id": "D_sakiko",
    "channel": "stable",
    "min_repair_client_version": "1.0.0",
    "allow": [
      "GPT_SoVITS/*.py",
      "GPT_SoVITS/**/*.py",
      "GPT_SoVITS/*.json",
      "GPT_SoVITS/**/*.json",
      "GPT_SoVITS/*.jinja",
      "GPT_SoVITS/**/*.jinja",
      "GPT_SoVITS/icons/*.svg",
      "GPT_SoVITS/icons/*.png",
      "GPT_SoVITS/char_headprof/*.png",
      "tools/*.py",
      "tools/**/*.py",
      "tools/*.json",
      "tools/**/*.json",
      "bridge/*.py",
      "dsakiko_webui/*.py",
      "dsakiko_webui/**/*.py",
      "dsakiko_webui/backend/pairing_ui_static/*.html",
      "dsakiko_webui/backend/pairing_ui_static/*.js",
      "dsakiko_webui/backend/pairing_ui_static/*.css",
      "dsakiko_webui/backend/pairing_ui_static/*.svg",
      "dsakiko_webui/shared/assets/access-gate/*.png",
      "version.json",
      "pyproject.toml",
      "uv.lock"
    ],
    "include": [
      "GPT_SoVITS/text/cmudict*.rep",
      "GPT_SoVITS/text/g2pw/polyphonic*.rep",
      "GPT_SoVITS/text/opencpop-strict.txt",
      "GPT_SoVITS/text/restr.rep",
      "dsakiko_webui/frontend/dist/**"
    ],
    "exclude": [
      "README*",
      "LICENSE*",
      "docs/**",
      "docs-site/**",
      "tests/**",
      "GPT_SoVITS/test/**",
      "dsakiko_webui/backend/test/**"
    ],
    "hard_exclude": [
      ".git/**",
      ".updates/**",
      ".update_backup/**",
      ".repair_backup/**",
      ".venv/**",
      "runtime/**",
      "logs/**",
      "reference_audio/**",
      "live2d_related/**",
      "avatar/**",
      "font/**",
      "wheels/**",
      "GPT_SoVITS/pretrained_models/**",
      "GPT_SoVITS/text/G2PWModel/**",
      "GPT_SoVITS/text/ja_userdic/**",
      "GPT_SoVITS/tool_data/**",
      "GPT_SoVITS/training_dir/**",
      "GPT_SoVITS/configs/*.yaml",
      "GPT_SoVITS/configs/*.yml",
      "GPT_SoVITS/text/engdict-hot.rep",
      "GPT_SoVITS/text/*.pickle",
      "GPT_SoVITS/text/**/*.pickle",
      "*.pyd",
      "*.so",
      "._*",
      ".DS_Store",
      "**/__MACOSX/**",
      "__MACOSX/**",
      "**/__pycache__/**",
      "__pycache__/**",
      "*.pyc",
      "d_sakiko_config.json",
      "dsakiko_config.json",
      "electron_frontend/node_modules/**",
      "electron_frontend/.vite/**",
      "electron_frontend/scripts/test-*.mjs",
      "electron_frontend/test/**",
      "electron_frontend/dist/**/*.map"
    ]
  },
  "profiles": {
    "macos-arm64": {
      "platform": "macos",
      "arch": "arm64",
      "include": [
        "*.command",
        "install_brew.sh"
      ],
      "exclude": [
        "*.bat",
        "electron_frontend/**"
      ]
    },
    "windows-x64": {
      "platform": "windows",
      "arch": "x64",
      "include": [
        "run.bat",
        "run_webui.bat",
        "启动参数配置.bat",
        "运行Live2D模型下载器.bat",
        "运行动作组编辑程序.bat",
        "运行小剧场模式.bat",
        "双击run.bat即可运行程序，注意不要有中文路径！",
        "electron_frontend/dist/**"
      ],
      "allow": [
        "run_electron.bat",
        "electron_frontend/package*.json",
        "electron_frontend/electron.vite.config.ts",
        "electron_frontend/tsconfig*.json",
        "electron_frontend/uno.config.ts",
        "electron_frontend/src/**",
        "dsakiko_webui/frontend/public/live2d.min.js",
        "electron_frontend/scripts/ensure-production-runtime.mjs"
      ],
      "hard_exclude": [
        "GPT_SoVITS/BigVGAN/**",
        "GPT_SoVITS/configs/**",
        "GPT_SoVITS/text/**",
        "GPT_SoVITS/tools/**",
        "GPT_SoVITS/module/**",
        "GPT_SoVITS/eres2net/**",
        "GPT_SoVITS/AR/data/**",
        "GPT_SoVITS/AR/modules/**",
        "GPT_SoVITS/AR/text_processing/**",
        "GPT_SoVITS/AR/utils/**",
        "GPT_SoVITS/f5_tts/**",
        "GPT_SoVITS/feature_extractor/**",
        "pyproject.toml",
        "uv.lock"
      ],
      "exclude": [
        "*.command",
        "install_brew.sh"
      ]
    }
  }
}
