{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dsakiko-feedback",
	"account_id": "155808c4f6d4785b0971d407f9da2258",
	"main": "src/intake.js",
	"compatibility_date": "2026-09-01",
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"ACCEPTING": "true",
		"ENABLED_SCHEMAS": "2"
	},
	"triggers": {
		"crons": [
			"17 * * * *"
		]
	},
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dsakiko-feedback",
			"database_id": "e256eab8-667b-49f9-91aa-d599350a70bc",
			"migrations_dir": "migrations"
		}
	],
	"routes": [
		{
			"pattern": "feedback.dsakiko.com",
			"custom_domain": true
		}
	]
}