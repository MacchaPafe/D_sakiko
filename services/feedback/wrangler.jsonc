{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsakiko-feedback",
  "main": "src/intake.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {"cpu_ms": 50},
  "vars": {"ACCEPTING": "false", "ENABLED_SCHEMAS": "1"},
  "triggers": {"crons": ["17 * * * *"]},
  "ratelimits": [{"name": "RATE_LIMITER", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}],
  "d1_databases": [{"binding": "DB", "database_name": "dsakiko-feedback", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}]
}
