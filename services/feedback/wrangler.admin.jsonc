{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsakiko-feedback-admin",
  "main": "src/admin.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {"cpu_ms": 50},
  "vars": {"ACCESS_TEAM": "", "ACCESS_AUD": ""},
  "d1_databases": [{"binding": "DB", "database_name": "dsakiko-feedback", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}]
}
